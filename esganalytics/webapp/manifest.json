{
  "_version": "1.86.0",
  "sap.app": {
    "id": "esganalytics",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:alp",
      "version": "1.33.0",
      "toolsId": "b13c758d-4069-4977-940e-3f0b23cd8a1d"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_esg_analytics_o4/srvd/sap/zui_esg_analytics/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.9",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "esganalytics.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "EmissionAnalyticsList",
          "target": "EmissionAnalyticsList"
        },
        {
          "pattern": "EmissionAnalytics({key}):?query:",
          "name": "EmissionAnalyticsObjectPage",
          "target": "EmissionAnalyticsObjectPage"
        }
      ],
      "targets": {
        "EmissionAnalyticsList": {
          "type": "Component",
          "id": "EmissionAnalyticsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/EmissionAnalytics",
              "variantManagement": "Page",
              "keyPerformanceIndicators": {
                "TotalCO2eKPI": {
                  "entitySet": "EmissionAnalytics",
                  "qualifier": "TotalCO2e"
                },
                "RecordCountKPI": {
                  "entitySet": "EmissionAnalytics",
                  "qualifier": "RecordCount"
                }
              },
              "navigation": {
                "EmissionAnalytics": {
                  "detail": {
                    "route": "EmissionAnalyticsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Multi"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "primary": [
                      {
                        "annotationPath": "@com.sap.vocabularies.UI.v1.PresentationVariant#default"
                      }
                    ],
                    "secondary": [
                      {
                        "annotationPath": "@com.sap.vocabularies.UI.v1.PresentationVariant#default"
                      }
                    ],
                    "defaultPath": "both"
                  }
                ]
              }
            }
          }
        },
        "EmissionAnalyticsObjectPage": {
          "type": "Component",
          "id": "EmissionAnalyticsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/EmissionAnalytics"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
