managed implementation in class zbp_i_emissionfactor unique;
strict(2);
with draft;

define behavior for ZI_EmissionFactor alias EmissionFactor
persistent table zesg_emfactor
draft table zesg_emfactor_d
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update;
  delete;

  field ( readonly : update ) ActivityType;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zesg_emfactor
  {
    ActivityType  = activity_type;
    Description   = description;
    Scope         = scope;
    FactorValue   = factor_value;
    Unit          = unit;
  }
}