managed implementation in class zbp_i_emissionrecord unique;
strict(2);
with draft;

define behavior for ZI_EmissionRecord alias EmissionRecord
persistent table zesg_emrec
draft table zesg_emrec_d
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update;
  delete;

  association _Items { create; with draft; }

field ( readonly, numbering : managed ) EmissionRecordId;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt,TotalCO2e;
  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zesg_emrec
  {
    EmissionRecordId  = emissionrecord_id;
    FacilityId        = facility_id;
    ReportingPeriod   = reporting_period;
    Scope             = scope;
    Status            = status;
    TotalCO2e         = total_co2e;
    CreatedBy         = created_by;
    CreatedAt         = created_at;
    LastChangedBy     = last_changed_by;
    LastChangedAt     = last_changed_at;
  }
}

define behavior for ZI_EmissionRecordItem alias EmissionRecordItem
persistent table zesg_emrecitm
draft table zesg_emrecitm_d
lock dependent by _EmissionRecord
authorization dependent by _EmissionRecord
{
  update;
  delete;

field ( readonly, numbering : managed ) EmissionRecordItemId;
field ( readonly ) EmissionRecordId,CO2e;
determination calculateItemCO2e on save { field Quantity, ActivityType; }

determination calculateTotalCO2e on save { field CO2e; }
  association _EmissionRecord;

  mapping for zesg_emrecitm
  {
    EmissionRecordItemId  = emissionrecorditem_id;
    EmissionRecordId      = emissionrecord_id;
    AssetId               = asset_id;
    ActivityType          = activity_type;
    Quantity               = quantity;
    Unit                   = unit;
    CO2e                   = co2e;
  }
}